# Auto-detect text files and normalize line endings to LF
* text=auto

# Shell scripts must always use LF line endings
*.sh text eol=lf

# Batch files should use CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Store screenshots, final sets only (raw captures and Koubou renders are git-ignored)
mobile/screenshots/appstore/** filter=lfs diff=lfs merge=lfs -text
mobile/screenshots/playstore/** filter=lfs diff=lfs merge=lfs -text
