using Toybox.Lang;
using Toybox.Test;

/**
 * QrCode against python-qrcode, module for module (vectors: `uv run scripts/qr-vectors.py`).
 * Run with `make test` (simulator started).
 */
(:test)
module QrCodeTest {
    // [text, rows], 1 = dark, no quiet zone
    const VECTORS = [
        [
            "https://pedalons.fr/garmin?code=ABC123",
            [
                "11111110010010011001001111111",
                "10000010001110011001101000001",
                "10111010111010101010101011101",
                "10111010011100011011001011101",
                "10111010001000011111001011101",
                "10000010010000011111101000001",
                "11111110101010101010101111111",
                "00000000111011100110100000000",
                "11101111101100101100111000100",
                "10101000101100011000111001001",
                "10000110110001001010010110111",
                "11111001100100000110110100010",
                "10000011000010001101111001011",
                "10111000000111011000011001001",
                "00101111111110100100110011011",
                "01101000001011110100001001010",
                "00001111001100101110011001011",
                "01010000001100111010111001101",
                "10100010100001000100110110011",
                "01111101011100011110111001010",
                "10001011011010010100111110000",
                "00000000100111000101100010111",
                "11111110101110100111101011011",
                "10000010101011111110100011011",
                "10111010100100101100111110011",
                "10111010010100101001100110111",
                "10111010100001001101010111001",
                "10000010111100011111110100010",
                "11111110101010001100110011011",
            ],
        ],
        [
            "https://aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
            [
                "11111110001100110011001111111",
                "10000010010111011101101000001",
                "10111010100010001000101011101",
                "10111010001100110011001011101",
                "10111010001100110011001011101",
                "10000010010111011101101000001",
                "11111110101010101010101111111",
                "00000000111101110111000000000",
                "11101111110011001100111000100",
                "01000101110011001100111001001",
                "11011111001000100010001110111",
                "01011101111101110111000100010",
                "01011011001011001100111001011",
                "10001101010011001100111001001",
                "01010110000000100010001111011",
                "10001100101101110111000101010",
                "00000110011011001100111001011",
                "01100000111011001100111001101",
                "10000010000000100010001110011",
                "01000000101101110111000101010",
                "10110111110011001100111110000",
                "00000000111011001101100010111",
                "11111110111000100011101011011",
                "10000010110101110110100011000",
                "10111010101011001100111110011",
                "10111010010011001100000110101",
                "10111010100000100010100111001",
                "10000010100101110111110000010",
                "11111110100011001101111010011",
            ],
        ],
        [
            "https://aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
            [
                "111111100010001000110011001111111",
                "100000100100010001011101101000001",
                "101110101001000100001000101011101",
                "101110100100110010110011001011101",
                "101110100100110010110011001011101",
                "100000100011101111011101101000001",
                "111111101010101010101010101111111",
                "000000001001000101110111000000000",
                "111011111000100011001100111000100",
                "110010011101110111001100111001001",
                "100001100011101110100010001111011",
                "110000011110111011110111000101010",
                "001111111011001101001100111001001",
                "010000001011001101001100111001101",
                "000001101000010000100010001110011",
                "100111001101000101110111000101010",
                "000010110010100011001100111000011",
                "110001011111110111001100111000101",
                "110001110001101110100010001111011",
                "010110011100111011110111000101010",
                "100010100101001111001100111000011",
                "010010000101001101001100111000101",
                "100100111010010000100010001111011",
                "011101001101000101110111000100010",
                "100101111100100011001100111110000",
                "000000001001110011001101100011011",
                "111111101101101000100011101011111",
                "100000101010111101110110100010011",
                "101110101101001011001100111110011",
                "101110100101001011001100000111001",
                "101110101010010000100010100111101",
                "100000101001000101110111110000010",
                "111111101100100011001101111010011",
            ],
        ],
        [
            "https://aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
            [
                "111111100011001100110011001111111",
                "100000100101110111011101101000001",
                "101110101000100010001000101011101",
                "101110100011001100110011001011101",
                "101110100011001100110011001011101",
                "100000100101110111011101101000001",
                "111111101010101010101010101111111",
                "000000001111011101110111000000000",
                "111011111100110011001100111000100",
                "010110010100110011001100111001001",
                "101000111010001000100010001111011",
                "100110001111011101110111000101010",
                "010000100010110011001100111001001",
                "100000011100110011001100111001101",
                "010111111000001000100010001110011",
                "100101010111011101110111000101010",
                "011011101110110011001100111000011",
                "101000000100110011001100111000101",
                "010101101010001000100010001111011",
                "101011010011011101110111000101010",
                "000011111010110011001100111000011",
                "001011001000110011001100111000101",
                "101110100110001000100010001111011",
                "010000011001011101110111000100010",
                "101010111010110011001100111110000",
                "000000001110110011001101100011011",
                "111111101000001000100011101011111",
                "100000101011011101110110100010011",
                "101110101100110011001100111110010",
                "101110100110110011001100000111010",
                "101110101010001000100010100111111",
                "100000101111011101110111110000010",
                "111111101010110011001101111010011",
            ],
        ],
    ];

    function render(modules as Lang.ByteArray) as Lang.Array<Lang.String> {
        var side = QrCode.sideOf(modules);
        var rows = [];
        for (var y = 0; y < side; y++) {
            var row = "";
            for (var x = 0; x < side; x++) {
                row += modules[y * side + x] == 1 ? "1" : "0";
            }
            rows.add(row);
        }
        return rows;
    }

    (:test)
    function encodesLikeReference(logger as Test.Logger) as Lang.Boolean {
        for (var v = 0; v < VECTORS.size(); v++) {
            var text = VECTORS[v][0];
            var expected = VECTORS[v][1];
            var modules = QrCode.encode(text);
            if (modules == null) {
                logger.error("no code for " + text);
                return false;
            }
            var actual = render(modules);
            if (actual.size() != expected.size()) {
                logger.error(text + ": side " + actual.size() + " instead of " + expected.size());
                return false;
            }
            for (var y = 0; y < expected.size(); y++) {
                if (!actual[y].equals(expected[y])) {
                    logger.error(
                        text + ": row " + y + " is " + actual[y] + " instead of " + expected[y]
                    );
                    return false;
                }
            }
        }
        return true;
    }

    (:test)
    function refusesTextBeyondVersion4(logger as Test.Logger) as Lang.Boolean {
        var text = "https://";
        for (var i = 0; i < 71; i++) {
            text += "a";
        }
        return QrCode.encode(text) == null;
    }
}
