# End-to-end test stack — read by scripts/e2e.sh and by frontend/playwright.config.ts.
#
# Committed on purpose: every value here is a throwaway that only ever reaches containers on the
# loopback, and the database it seeds starts empty. That emptiness is the point — the local stack
# holds a biketeam restore with thousands of real addresses, and a test run sends OTPs and
# invitations. Never point this file at that database, nor the mailer at anything but mailhog.
#
# Everything is offset from the workstation stack (tribly-local) so both run side by side.

ENV_NAME=tribly-e2e
HTTP_PORT=8190
POSTGRES_HOST_PORT=15432
# mailhog's HTTP API, read by the tests to fetch OTP codes and verification links.
E2E_MAILHOG_PORT=18025
# valhalla + tileserver are borrowed from the workstation stack rather than run twice (17 GB of
# routing tiles). scripts/e2e.sh falls back to an empty network when it is not up: the stack still
# starts, only routing and map tiles fail.
E2E_SHARED_NETWORK=tribly-local-shared

FRONTEND_SOURCEMAP=true
FRONTEND_PREFETCH_AUDIT=false

PEDALONS_BOOTSTRAP_DOMAIN=localhost
PEDALONS_BOOTSTRAP_DOMAIN_NAME="Pédalons E2E"
PEDALONS_BOOTSTRAP_BASE_URL=http://localhost:8190
PEDALONS_BOOTSTRAP_ADMIN_EMAIL=admin@e2e.test
PEDALONS_BOOTSTRAP_ADMIN_DISPLAY_NAME="Admin E2E"

PUID=1000
PGID=1000

POSTGRES_DB=pedalons
POSTGRES_USER=pedalons
POSTGRES_PASSWORD=e2e-postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

MINIO_ROOT_USER=pedalons
MINIO_ROOT_PASSWORD=e2e-minio-secret
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=pedalons
MINIO_SECRET_KEY=e2e-minio-secret
STORAGE_BUCKET=pedalons
DATA_CACHE_PATH=/mnt/cache

IMGPROXY_URL=http://varnish:80
VALHALLA_URL=http://valhalla:8002
TILESERVER_URL=http://tileserver:8080

CORS_ORIGINS=
ENCRYPTION_KEY=ZTJlLXRlc3Qtb25seS1lbmNyeXB0aW9uLWtleS0zMmI=

STRAVA_BASE_URL=https://www.strava.com
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_CALLBACK_BASE_URL=
SOCIAL_PLACEHOLDER_EMAIL_DOMAIN=e2e.test

PEDALONS_PUSH_ENABLED=false

# mailhog, and nothing else: see the header.
QUARKUS_MAILER_FROM=noreply@e2e.test
QUARKUS_MAILER_HOST=mailhog
QUARKUS_MAILER_PORT=1025
QUARKUS_MAILER_START_TLS=DISABLED
QUARKUS_MAILER_LOGIN=DISABLED
