# Copy to .env beside docker-compose.yml, on the backup host. Any SMTP relay will do — ideally not
# the one the application sends through, so that its outage does not silence this alert too.
GATUS_BIND=127.0.0.1
GATUS_SMTP_HOST=smtp.example.org
GATUS_SMTP_PORT=587
GATUS_SMTP_USERNAME=########
GATUS_SMTP_PASSWORD=########
GATUS_SMTP_FROM=gatus@example.org
GATUS_ALERT_TO=########
