{
  "$schema": "node_modules/@openapitools/openapi-generator-cli/config.schema.json",
  "spaces": 2,
  "generator-cli": {
    "version": "7.10.0",
    "generators": {
      "dart-dio": {
        "generatorName": "dart-dio",
        "inputSpec": "../contracts/openapi.json",
        "output": "lib/api/generated",
        "additionalProperties": {
          "pubName": "tribly_api",
          "pubAuthor": "Tribly",
          "pubDescription": "Tribly API Client",
          "useEnumExtension": true,
          "serializationLibrary": "json_serializable",
          "dateLibrary": "core"
        },
        "globalProperty": {
          "models": "",
          "apis": "",
          "supportingFiles": ""
        }
      }
    }
  }
}
