<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing of the app leaves the device, by cloud backup or device-to-device transfer.
  allowBackup="false" alone no longer covers the second on Android 12+, hence this file.
  Why: backing up would be a data flow to Google the privacy policy does not describe, and a
  restored flutter_secure_storage file is undecryptable anyway (its Keystore key is never
  backed up). See mobile/store-metadata/data-safety.md.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
