<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push notifications. `development` is what a debug build needs; Xcode rewrites it to
	     `production` when the app is archived for TestFlight or the App Store. The APNs key
	     uploaded to Firebase covers both environments. -->
	<key>aps-environment</key>
	<string>development</string>
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:www.pedalons.fr</string>
		<string>webcredentials:www.pedalons.fr</string>
	</array>
</dict>
</plist>
