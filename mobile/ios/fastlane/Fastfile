# Uncomment the line if you want fastlane to automatically update itself
# update_fastlane

default_platform(:ios)

# App Store Connect API key, kept out of the repo in ~/.appstoreconnect/ (override with ASC_KEY_DIR):
# the AuthKey_<KEY_ID>.p8 downloaded from App Store Connect (Users and Access → Integrations) and an
# `issuer_id` file holding the Issuer ID shown on that same page. Apple ID login (password + 2FA)
# is no longer used: Apple's web sign-in answers 403 to fastlane's SIRP flow.
def asc_api_key
  dir = File.expand_path(ENV.fetch("ASC_KEY_DIR", "~/.appstoreconnect"))
  keys = Dir.glob(File.join(dir, "AuthKey_*.p8"))
  UI.user_error!("Expected exactly one AuthKey_*.p8 in #{dir}, found #{keys.size}") unless keys.size == 1
  issuer_file = File.join(dir, "issuer_id")
  UI.user_error!("Missing #{issuer_file} (the Issuer ID from App Store Connect)") unless File.exist?(issuer_file)

  app_store_connect_api_key(
    key_id: File.basename(keys.first, ".p8").delete_prefix("AuthKey_"),
    issuer_id: File.read(issuer_file).strip,
    key_filepath: keys.first
  )
end

platform :ios do
  desc "Push a new beta build to TestFlight. Run `flutter build ios --release --no-codesign` from the project root first. Build number comes from pubspec.yaml."
  lane :beta do
    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      export_method: "app-store",
      # Automatic signing only refreshes its cached profile when allowed to. Without this, a new
      # entitlement (aps-environment for push) fails the archive against the stale profile.
      xcargs: "-allowProvisioningUpdates",
      export_xcargs: "-allowProvisioningUpdates",
      export_options: {
        signingStyle: "automatic"
      }
    )
    upload_to_testflight(api_key: asc_api_key, skip_waiting_for_build_processing: true)
  end

  desc "Promote the TestFlight build matching the current pubspec.yaml version to the App Store version in App Store Connect. Run `beta` for that exact version first — this lane does not build or upload a binary. Metadata and screenshots stay untouched (the App Store listing is versioned in mobile/metadata/ and pushed with `asc`, see store-metadata/README.md) and the version is left unsubmitted so you can review it in App Store Connect before submitting for review."
  lane :release do
    version_line = File.read("../../pubspec.yaml")[/^version:\s*(\S+)/, 1]
    app_version, build_number = version_line.split("+")

    upload_to_app_store(
      api_key: asc_api_key,
      app_version: app_version,
      build_number: build_number,
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_metadata: true,
      submit_for_review: false,
      automatic_release: false,
      force: true
    )
  end
end
