!data/keys/*.sh

# mkcert certificates for local HTTPS development
frontend/*.pem

.playwright-mcp
.superdesign
.superpowers

# Crawl account passwords for scripts/ssr-audit.mjs — never commit
scripts/.env.users

# asc CLI local state (metadata review artifacts, apply reports)
.asc/

# End-to-end test stack (scripts/e2e.sh): keys, storage and cache of the tribly-e2e backend
/.e2e/
# Playwright (frontend/e2e): saved sessions, seed, traces and HTML report
frontend/e2e/.auth/
frontend/e2e/.results/
frontend/e2e/.report/

# Store screenshots: demo account passwords and raw/framed captures
mobile/screenshots/accounts.local.json
mobile/screenshots/flat/
