<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.PedalonsKaroo">

        <!-- Karoo Extension Service -->
        <service
            android:name=".PedalonsExtension"
            android:exported="true">
            <intent-filter>
                <action android:name="io.hammerhead.karooext.KAROO_EXTENSION" />
            </intent-filter>
            <meta-data
                android:name="io.hammerhead.karooext.EXTENSION_INFO"
                android:resource="@xml/extension_info" />
        </service>

        <!-- Main Activity for route browsing -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.PedalonsKaroo">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Auth Activity for device code flow -->
        <activity
            android:name=".auth.AuthActivity"
            android:exported="false"
            android:theme="@style/Theme.PedalonsKaroo" />

        <!-- GPS Connect Activity for Hammerhead OAuth -->
        <activity
            android:name=".auth.GpsConnectActivity"
            android:exported="false"
            android:theme="@style/Theme.PedalonsKaroo" />

    </application>

</manifest>
