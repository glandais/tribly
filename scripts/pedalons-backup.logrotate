# Rotation of the backup logs. Install as /etc/logrotate.d/backup on the production host:
#
#   install -m 644 scripts/pedalons-backup.logrotate /etc/logrotate.d/backup
#   mkdir -p /var/log/backup
#   logrotate -d /etc/logrotate.d/backup     # dry run
#
# The glob, the directory and the settings match the ones already used on the backup host for
# ns3085825 (backup.log, backup-mongo.log), so every backup log on every machine rotates the same
# way — and a host that already has this file needs nothing.
#
# create 0640 root adm: the scripts run as root, and members of `adm` can read the logs without it.
/var/log/backup/*.log {
    daily
    rotate 30
    compress
    delaycompress
    missingok
    notifempty
    create 0640 root adm
}
