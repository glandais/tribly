{
  "name": "tribly-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@10.26.1",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "serve": "pnpm build && vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write --cache \"src/**/*.{ts,tsx,css}\" \"!src/components/ui/**\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"!src/components/ui/**\"",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "generate-api": "rm -rf src/api && orval --config orval.config.js && pnpm format",
    "i18n:lint": "i18next-cli lint",
    "i18n:status": "i18next-cli status",
    "i18n:extract": "i18next-cli extract"
  },
  "dependencies": {
    "@fullcalendar/core": "7.0.0-beta.6",
    "@fullcalendar/daygrid": "7.0.0-beta.6",
    "@fullcalendar/interaction": "7.0.0-beta.6",
    "@fullcalendar/react": "7.0.0-beta.6",
    "@fullcalendar/multimonth": "7.0.0-beta.6",
    "@fullcalendar/timegrid": "7.0.0-beta.6",
    "@fullcalendar/theme-classic": "7.0.0-beta.6",
    "@mantine/core": "^8.3.12",
    "@mantine/dates": "^8.3.12",
    "@mantine/form": "^8.3.12",
    "@mantine/hooks": "^8.3.12",
    "@mantine/notifications": "^8.3.12",
    "@mantine/tiptap": "^8.3.12",
    "@tabler/icons-react": "^3.36.1",
    "@tanstack/react-query": "^5.90.16",
    "@tiptap/core": "^3.15.3",
    "@tiptap/extension-link": "^3.15.3",
    "@tiptap/extension-placeholder": "^3.15.3",
    "@tiptap/extension-table": "^3.15.3",
    "@tiptap/extension-table-cell": "^3.15.3",
    "@tiptap/extension-table-header": "^3.15.3",
    "@tiptap/extension-table-row": "^3.15.3",
    "@tiptap/pm": "^3.15.3",
    "@tiptap/react": "^3.15.3",
    "@tiptap/starter-kit": "^3.15.3",
    "@versatiles/style": "^5.8.4",
    "axios": "^1.7.9",
    "chart.js": "^4.5.1",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "dayjs": "^1.11.19",
    "geokdbush": "^2.0.1",
    "i18next": "^25.7.4",
    "i18next-browser-languagedetector": "^8.2.0",
    "kdbush": "^4.0.2",
    "keycloak-js": "^26.0.7",
    "mantine-form-zod-resolver": "^1.3.0",
    "maplibre-gl": "^5.16.0",
    "maplibre-theme": "^1.0.0",
    "react": "^19.2.3",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.3",
    "react-i18next": "^16.5.2",
    "react-map-gl": "^8.1.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.4.0",
    "react-router-dom": "^7.12.0",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remove-markdown": "^0.6.2",
    "tiptap-markdown": "^0.9.0",
    "unist-util-visit": "^5.0.0",
    "zod": "^4.3.5",
    "zustand": "^5.0.10"
