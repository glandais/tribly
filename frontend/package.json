{
  "name": "pedalons-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319",
  "scripts": {
    "copy-legal": "mkdir -p src/assets/legal && cp ../privacy/*.md src/assets/legal/ 2>/dev/null || true",
    "predev": "pnpm copy-legal",
    "dev": "vite",
    "prebuild": "pnpm copy-legal",
    "build": "vite build",
    "typecheck": "tsgo -b",
    "preview": "vite preview",
    "serve": "pnpm build && vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write --no-cache \"src/**/*.{ts,tsx,css}\" \"!src/components/ui/**\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"!src/components/ui/**\"",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "generate-api": "rm -rf src/api && orval --config orval.config.js",
    "generate-routes": "node ../scripts/generate-routes.mjs",
    "i18n:lint": "i18next-cli lint",
    "i18n:status": "i18next-cli status",
    "i18n:extract": "i18next-cli extract",
    "generate-icons": "pwa-assets-generator --config pwa-assets.config.ts",
    "check": "pnpm install && pnpm generate-api && pnpm generate-routes && pnpm format && pnpm typecheck && pnpm lint && pnpm build"
  },
  "dependencies": {
    "@mantine/core": "^9.3.2",
    "@mantine/dates": "^9.3.2",
    "@mantine/form": "^9.3.2",
    "@mantine/hooks": "^9.3.2",
    "@mantine/notifications": "^9.3.2",
    "@mantine/schedule": "^9.3.2",
    "@mantine/tiptap": "^9.3.2",
    "@simplewebauthn/browser": "^13.3.0",
    "@tabler/icons-react": "^3.44.0",
    "@tanstack/react-query": "^5.101.0",
    "@tiptap/core": "^3.27.1",
    "@tiptap/extension-link": "^3.27.1",
    "@tiptap/extension-placeholder": "^3.27.1",
    "@tiptap/extension-table": "^3.27.1",
    "@tiptap/extension-table-cell": "^3.27.1",
    "@tiptap/extension-table-header": "^3.27.1",
    "@tiptap/extension-table-row": "^3.27.1",
    "@tiptap/pm": "^3.27.1",
    "@tiptap/react": "^3.27.1",
    "@tiptap/starter-kit": "^3.27.1",
    "@versatiles/style": "^5.12.1",
    "axios": "^1.18.0",
    "chart.js": "^4.5.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "dayjs": "^1.11.21",
    "geokdbush": "^2.1.0",
    "i18next": "^26.3.1",
    "i18next-browser-languagedetector": "^8.2.1",
    "kdbush": "^4.1.0",
    "maplibre-gl": "^5.24.0",
    "maplibre-theme": "^1.0.0",
    "react": "^19.2.7",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.8",
    "react-map-gl": "^8.1.1",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.11.2",
    "react-router-dom": "^7.18.0",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remove-markdown": "^0.6.4",
    "tiptap-markdown": "^0.9.0",
    "unist-util-visit": "^5.1.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.2",
    "@types/mdast": "^4.0.4",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/react-map-gl": "^6.1.8",
    "@types/unist": "^3.0.3",
    "@typescript/native-preview": "latest",
    "@vite-pwa/assets-generator": "^1.0.2",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.9",
    "@vitest/ui": "^4.1.9",
    "eslint": "^10.5.0",
    "eslint-plugin-i18next": "^6.1.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "17.6.0",
    "i18next-cli": "^1.64.1",
    "jsdom": "^29.1.1",
    "mdast-util-directive": "^3.1.0",
    "orval": "^8.18.0",
    "postcss": "^8.5.14",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "prettier": "^3.8.4",
    "rollup-plugin-visualizer": "^7.0.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.61.1",
    "vite": "^8.0.16",
    "vitest": "^4.1.9",
    "yaml": "^2.9.0"
  }
}
