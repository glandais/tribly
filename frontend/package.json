{
  "name": "tribly-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@10.26.1",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "generate-api": "rm -rf src/api && openapi-generator-cli generate -i ../contracts/openapi.json -g typescript-axios -o src/api --additional-properties=supportsES6=true,npmName=@tribly/api,modelPropertyNaming=snake_case && rm -rf src/api/docs && prettier --write \"src/api/**/*.ts\" && find src/api -name '*.ts' -exec sed -i '1s|^|// @ts-nocheck\\n|' {} \\;",
    "i18n:lint": "i18next-cli lint",
    "i18n:status": "i18next-cli status",
    "i18n:extract": "i18next-cli extract"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@mdxeditor/editor": "^3.52.3",
    "@tanstack/react-query": "^5.90.16",
    "@versatiles/style": "^5.8.4",
    "axios": "^1.7.9",
    "chart.js": "^4.5.1",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "i18next": "^25.7.3",
    "i18next-browser-languagedetector": "^8.2.0",
    "keycloak-js": "^26.0.7",
    "maplibre-gl": "^5.15.0",
    "react": "^19.2.3",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.3",
    "react-i18next": "^16.5.1",
    "react-map-gl": "^8.1.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.11.0",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remove-markdown": "^0.6.2",
    "unist-util-visit": "^5.0.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@openapitools/openapi-generator-cli": "^2.27.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.1",
    "@types/mdast": "^4.0.4",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/react-map-gl": "^6.1.7",
    "@types/unist": "^3.0.3",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "^4.0.16",
    "@vitest/ui": "^4.0.16",
    "eslint": "^9.39.2",
    "eslint-plugin-i18next": "^6.1.3",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "16.5.0",
    "i18next-cli": "^1.33.5",
    "jsdom": "^27.4.0",
    "mdast-util-directive": "^3.1.0",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "rollup-plugin-visualizer": "^6.0.5",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.51.0",
    "vite": "^7.3.0",
    "vitest": "^4.0.16"
  }
}
