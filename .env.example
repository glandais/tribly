HTTP_PORT=8090
ENV_NAME=pedalons-prod
# Ship frontend .js.map alongside the build (build.sh --build-arg to the Dockerfile). Set to
# true on the staging host only — leave false/unset in prod so source isn't exposed there.
FRONTEND_SOURCEMAP=false

# Log a console.warn for queries fetched after first paint that routes.config.ts's prefetch()
# didn't cover (see frontend/src/lib/prefetchAudit.ts). Read by vite.config.ts (build.sh forwards
# it as a Docker build-arg too — see Dockerfile). Safe to turn on anywhere, including staging/prod,
# since it only ever logs to the visitor's own browser console.
FRONTEND_PREFETCH_AUDIT=false

# Bootstrap: the Domain every team belongs to, and its PLATFORM_ADMIN.
# BOOTSTRAP_DOMAIN is the hostname matched against X-Forwarded-Host / Host to resolve the tenant.
# BOOTSTRAP_BASE_URL only builds absolute URLs: email links and the WebAuthn origin of passkeys.
# Both are read once, when the Domain row is created; later edits go through the admin UI.
PEDALONS_BOOTSTRAP_DOMAIN=pedalons.fr
PEDALONS_BOOTSTRAP_DOMAIN_NAME=Pédalons
PEDALONS_BOOTSTRAP_BASE_URL=https://www.pedalons.fr
PEDALONS_BOOTSTRAP_ADMIN_EMAIL=########
# Quote any value containing a space — .env is sourced by build.sh and scripts/biketeam_restore.sh.
PEDALONS_BOOTSTRAP_ADMIN_DISPLAY_NAME="########"

# User ID/Group ID for file permissions (run: id -u && id -g)
PUID=1000
PGID=1000

# PostgreSQL
POSTGRES_DB=pedalons
POSTGRES_USER=pedalons
POSTGRES_PASSWORD=########
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Loopback port the postgres container publishes on the host, for tooling such as
# scripts/biketeam_restore.sh. Bump it if something else already listens on 5432.
POSTGRES_HOST_PORT=5432

# Storage (MinIO/S3)
# MinIO root credentials (used by MinIO container and all clients)
MINIO_ROOT_USER=pedalons
MINIO_ROOT_PASSWORD=########
MINIO_ENDPOINT=http://minio:9000
# Backend S3 credentials (must match MINIO_ROOT_USER/PASSWORD)
MINIO_ACCESS_KEY=pedalons
MINIO_SECRET_KEY=########
STORAGE_BUCKET=pedalons
# Map tiles and elevation data downloaded by gpx2web. Bind-mounted to ./data/cache so it survives
# `docker compose down`: refilling it means re-rendering every tile and re-fetching every elevation
# tile from tiles.mapterhorn.com.
# Must stay INSIDE the container (/mnt/cache): pointing it at /tmp silently throws the cache away on
# every restart. Do NOT share this directory between environments -- gpx2web writes tiles straight to
# their final path, so two backends racing on the same file cache a truncated image for good.
DATA_CACHE_PATH=/mnt/cache

# Services URLs
# valhalla and tileserver live in the shared stack (docker-compose.shared.yml); the hostnames below
# are their service names on the `pedalons-shared` network, so these values stay the same.
IMGPROXY_URL=http://varnish:80
VALHALLA_URL=http://valhalla:8002
TILESERVER_URL=http://tileserver:8080
# VALHALLA_TILE_URLS belongs to the shared stack's own .env, not here.

# CORS (comma-separated origins, empty for same-origin only)
CORS_ORIGINS=

# GPS Device Integration
# Token encryption key (generate with: openssl rand -base64 32)
ENCRYPTION_KEY=########

# Strava login / account recovery (single global OAuth app).
# Register an app at https://www.strava.com/settings/api and set the
# "Authorization Callback Domain" to this deployment's host.
# Leave blank to disable the "Continue with Strava" button.
#
# Where the OAuth endpoints live. Default https://www.strava.com — talk to Strava directly.
# Set it to a strava-auth-proxy instance (https://auth.pedalons.fr) to share one real Strava
# app across deployments; the proxy serves the same paths, and CLIENT_ID/CLIENT_SECRET below
# are then the *virtual* credentials it issued, with this deployment's callback URL listed in
# the proxy's clients.json. The "Authorization Callback Domain" registered on the real Strava
# app is the proxy's host, not ours.
STRAVA_BASE_URL=https://www.strava.com
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Optional: fixed callback host if it differs from the request host (multi-domain).
# Leave blank for a single-domain deployment.
STRAVA_CALLBACK_BASE_URL=
# Mail domain of the placeholder addresses given to migrated Strava accounts
# (must match the biketeam migration's placeholder-email-domain).
SOCIAL_PLACEHOLDER_EMAIL_DOMAIN=pedalons.fr

# Email
#
# In the prod profile the backend sends via the Brevo REST API, not SMTP
# (see %prod.pedalons.email.brevo.enabled in application.properties).
# BREVO_API_KEY is therefore REQUIRED: without it, registration fails.
#
# Brevo rejects calls from IPs missing from its allowlist, with a 401 that the
# backend replays verbatim -- surfacing as a misleading "401 UNKNOWN" on
# /api/auth/register. Add the server's public IP at:
#   https://app.brevo.com/security/authorised_ips
BREVO_API_KEY=########

# Backups (scripts/backup.sh, scripts/restore.sh)
#
# The BACKUP_* settings do NOT belong here. docker-compose passes this whole file to the backend
# container (env_file), so the backup destination, the SSH key path and the Healthchecks URL would
# end up inside the application -- and inside the backup of it.
#
# They live in /root/pedalons-backup.env instead (root-only, not versioned), overridable with
# BACKUP_ENV_FILE. See "Backup and restore" in README.md. Template:
#
#   BACKUP_REMOTE=pedalonsbackup@10.10.0.2
#   BACKUP_REMOTE_PATH=/                     # relative to the rrsync root of the restricted key
#   BACKUP_SSH_KEY=/root/.ssh/id_pedalons_backup
#   BACKUP_KEEP=30                           # applied by backup-prune.sh, on the backup host
#   BACKUP_PING_URL=https://hc-ping.com/xxxxxxxx
#   # BACKUP_SSH_PORT=2222                   # only if the destination is not on 22
#   # BACKUP_SECRETS_PASSPHRASE_FILE=/root/.pedalons-backup-pass

# SMTP fallback, used only when pedalons.email.brevo.enabled=false
QUARKUS_MAILER_FROM=noreply@yourdomain.com
QUARKUS_MAILER_HOST=smtp-relay.brevo.com
QUARKUS_MAILER_PORT=587
QUARKUS_MAILER_USERNAME=your-brevo-login@example.com
QUARKUS_MAILER_PASSWORD=########
QUARKUS_MAILER_START_TLS=REQUIRED
