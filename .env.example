HTTP_PORT=8090
TRAEFIK_STACK=tribly-prod

# User ID/Group ID for file permissions (run: id -u && id -g)
PUID=1000
PGID=1000

# PostgreSQL
POSTGRES_DB=tribly
POSTGRES_USER=tribly
POSTGRES_PASSWORD=########
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Storage (MinIO/S3)
MINIO_ROOT_USER=tribly
MINIO_ROOT_PASSWORD=########
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=tribly
MINIO_SECRET_KEY=########
STORAGE_BUCKET=tribly
DATA_CACHE_PATH=/tmp/tribly-data-cache

# Services URLs
IMGPROXY_URL=http://varnish:80
BROUTER_URL=http://brouter:17777

# CORS (comma-separated origins, empty for same-origin only)
CORS_ORIGINS=

# Mapbox
MAPBOX_API_KEY=########

# GPS Device Integration
# Token encryption key (generate with: openssl rand -base64 32)
ENCRYPTION_KEY=########
# Hammerhead OAuth credentials (https://dashboard.hammerhead.io)
HAMMERHEAD_CLIENT_ID=
HAMMERHEAD_CLIENT_SECRET=
# Garmin Connect OAuth credentials (https://connect.garmin.com/developer)
GARMIN_CLIENT_ID=

# Email (Brevo SMTP)
QUARKUS_MAILER_FROM=noreply@yourdomain.com
QUARKUS_MAILER_HOST=smtp-relay.brevo.com
QUARKUS_MAILER_PORT=587
QUARKUS_MAILER_USERNAME=your-brevo-login@example.com
QUARKUS_MAILER_PASSWORD=########
QUARKUS_MAILER_START_TLS=REQUIRED
