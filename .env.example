HTTP_PORT=8090
TRAEFIK_STACK=tribly-prod

# PostgreSQL
POSTGRES_DB=tribly
POSTGRES_USER=tribly
POSTGRES_PASSWORD=########
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
KEYCLOAK_DB=keycloak

# Keycloak
KEYCLOAK_USER=admin
KEYCLOAK_PASSWORD=########
# Keycloak via Traefik (same base URL for browser and backend)
KEYCLOAK_URL=http://localhost:8090
KEYCLOAK_INTERNAL_URL=http://traefik:80
KEYCLOAK_REALM=tribly
KEYCLOAK_FRONTEND_CLIENT_ID=tribly-frontend

# Storage
STORAGE_PATH=/mnt/storage
DATA_CACHE_PATH=/tmp/tribly-data-cache

# Services URLs
IMGPROXY_URL=http://varnish:80
BROUTER_URL=http://brouter:17777

# CORS (comma-separated origins, empty for same-origin only)
CORS_ORIGINS=

# Mapbox
MAPBOX_API_KEY=########

# Security
QUARKUS_OIDC_TOKEN_STATE_MANAGER_ENCRYPTION_SECRET=########
