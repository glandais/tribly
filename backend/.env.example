# OIDC Token State Manager Encryption Secret
# This secret is used to encrypt the state parameter in the OIDC authentication flow.
# It's required in production to secure the authentication state.
#
# REQUIRED: Production environments
# OPTIONAL: Development and test (uses default if not set)
#
# How to generate a secure secret (at least 32 characters recommended):
#   openssl rand -base64 32
#
# Example:
#   QUARKUS_OIDC_TOKEN_STATE_MANAGER_ENCRYPTION_SECRET=your-generated-secret-here
#
# Security notes:
# - Keep this secret secure and never commit it to version control
# - Use a different secret for each environment (dev, staging, prod)
# - Rotate this secret periodically as part of security maintenance
QUARKUS_OIDC_TOKEN_STATE_MANAGER_ENCRYPTION_SECRET=

# Mapbox API Key for map features
MAPBOX_API_KEY=
